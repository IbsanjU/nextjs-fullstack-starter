# Environment
APP_ENV=local

# App Metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database Feature Flags
ENABLE_DB=true
LOCAL_DB=true

# Database Connection
# For local Docker: postgresql://app:app@localhost:5432/app?schema=public
# For remote (Neon/Supabase): postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public
